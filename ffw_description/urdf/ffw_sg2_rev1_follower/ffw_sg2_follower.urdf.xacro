<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ffw_sg2_follower">
  <xacro:property name="meshes_file_direction" value="package://ffw_description/meshes/$(arg model)" />
  <xacro:property name="swerve_meshes_dir" value="package://ffw_description/meshes/common/follower/ffw_swerve" />
  <xacro:arg name="use_sim" default="false" />
  <xacro:arg name="use_mock_hardware" default="false" />
  <xacro:arg name="mock_sensor_commands" default="false" />
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="model" default="ffw_sg2_rev1_follower" />
  <xacro:arg name="ros2_control_type" default="ffw_sg2_follower" />
  <!-- End effectors on the arm flanges: gripper (default, RH-P12-RN-A), none (bare flanges) or
       sharpa (Sharpa Wave hands; needs ffw_sharpa_hardware/scripts/setup_sharpa.sh).
       With sharpa: "hands" picks the mounted hands (both, left or right); sharpa_adapter is the
       wrist adapter (a_v2: arm keeps 7 joints); *_hand_mount_deg is each hand's rotation about the
       wrist axis (built robot: 0 on both hands); the hands' identities come from the
       *_hand_ip / *_hand_serial arguments (empty: factory IP for that side). -->
  <xacro:arg name="end_effector" default="gripper" />
  <xacro:arg name="hands" default="both" />
  <xacro:arg name="left_hand_ip" default="" />
  <xacro:arg name="right_hand_ip" default="" />
  <xacro:arg name="left_hand_serial" default="" />
  <xacro:arg name="right_hand_serial" default="" />
  <xacro:arg name="hand_speed_coeff" default="0.3" />
  <xacro:arg name="sharpa_adapter" default="a_v2" />
  <xacro:arg name="left_hand_mount_deg" default="0" />
  <xacro:arg name="right_hand_mount_deg" default="0" />
  <xacro:property name="end_effector" value="$(arg end_effector)" />
  <xacro:property name="use_gripper" value="${end_effector == 'gripper'}" />
  <xacro:property name="left_hand" value="${end_effector == 'sharpa' and '$(arg hands)' in ('both', 'left')}" />
  <xacro:property name="right_hand" value="${end_effector == 'sharpa' and '$(arg hands)' in ('both', 'right')}" />

  <xacro:include filename="$(find ffw_description)/urdf/common/follower/ffw_follower_body.xacro" />

  <xacro:if value="${use_gripper}">
    <xacro:include filename="$(find ffw_description)/urdf/common/rh_p12_rn_a/rh_p12_rn_a.urdf.xacro" />
  </xacro:if>
  <xacro:if value="${left_hand or right_hand}">
    <xacro:include filename="$(find ffw_description)/urdf/common/sharpa_wave/sharpa_wave_mount.urdf.xacro" />
    <xacro:include filename="$(find ffw_description)/ros2_control/common/sharpa_wave/sharpa_wave_hand.ros2_control.xacro" />
  </xacro:if>
  <xacro:if value="${left_hand}">
    <xacro:include filename="$(find left_sharpa_wave)/left_sharpa_wave.urdf" />
  </xacro:if>
  <xacro:if value="${right_hand}">
    <xacro:include filename="$(find right_sharpa_wave)/right_sharpa_wave.urdf" />
  </xacro:if>

  <xacro:include filename="$(find ffw_description)/ros2_control/$(arg model)/$(arg ros2_control_type).ros2_control.xacro" />
  <xacro:include filename="$(find ffw_description)/ros2_control/$(arg model)/ffw_sg2_base.ros2_control.xacro" />
  <xacro:include filename="$(find ffw_description)/ros2_control/$(arg model)/ffw_sg2_sensor.ros2_control.xacro" />

  <xacro:include filename="$(find ffw_description)/gazebo/$(arg model)/ffw_sg2_follower.gazebo.xacro" />

  <link name="$(arg prefix)base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/base_mobile_assy.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/base_mobile_assy.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <inertial>
       <!-- Center the base inertia to reduce biased yaw under straight motion -->
       <origin xyz="0 0 0" />
       <mass value="3.598943900e+01" />
       <inertia ixx="1.725473500" ixy="6.471795500e-06" ixz="1.890204600e-05"
       iyy="3.983747500" iyz="1.716567300e-05"
       izz="2.846139500" />
    </inertial>
  </link>

  <joint name="$(arg prefix)lidar_l_joint" type="fixed">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)lidar_l_link"/>
    <origin xyz="-0.111881 0.240 0.34432" rpy="0 0 1.57079632679"/>
  </joint>

  <link name="$(arg prefix)lidar_l_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.03"/>
      </geometry>
    </visual>
  </link>
  <joint name="$(arg prefix)lidar_r_joint" type="fixed">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)lidar_r_link"/>
    <origin xyz="-0.111881 -0.240 0.34432" rpy="0 0 -1.57079632679"/>
  </joint>
  <!-- <link name="$(arg prefix)lidar_r_link">
  </link> -->

  <joint name="$(arg prefix)imu_joint" type="fixed">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)imu_link"/>
    <origin xyz="-0.1464 0.0 0.26" rpy="0 0 0"/>
  </joint>
  <link name="$(arg prefix)imu_link">
  </link>
  <link name="$(arg prefix)lidar_r_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.03"/>
      </geometry>
      <material name="blue"><color rgba="0 0 1 1"/></material>
    </visual>
  </link>
  <link name="$(arg prefix)lift_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/lift_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/lift_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <inertial>
       <origin xyz="-1.286987800e-01 -1.604580800e-05 8.945601700e-01" />
       <mass value="17.9" />
       <inertia ixx="0.0100947" ixy="-0.0000000356" ixz="0.0012131"
                iyy="0.0102705" iyz="0.0000000702"
                izz="0.0001971" />
    </inertial>
  </link>
  <joint name="$(arg prefix)lift_fixed_joint" type="fixed">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)lift_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo plugins/sensors -->
  <xacro:ffw_sg2_follower_gazebo prefix="$(arg prefix)" />

  <xacro:ffw_follower_body parent="$(arg prefix)base_link" prefix="$(arg prefix)">
    <origin xyz="-0.0199 0 1.4316" rpy="0 0 0" />
  </xacro:ffw_follower_body>

  <xacro:if value="${use_gripper}">
    <xacro:rh_p12_rn_a parent="$(arg prefix)arm_l_link7" prefix="$(arg prefix)gripper_l_">
      <origin xyz="0 0 -0.078" rpy="0 3.14159265359 3.14159265359"/>
    </xacro:rh_p12_rn_a>
  </xacro:if>
  <xacro:if value="${left_hand}">
    <xacro:sharpa_wave_mount side="left" parent="$(arg prefix)arm_l_link7"
      adapter="$(arg sharpa_adapter)" mount_yaw="${radians(float($(arg left_hand_mount_deg)))}" />
  </xacro:if>

  <joint name="$(arg prefix)end_effector_l_joint" type="fixed">
    <parent link="$(arg prefix)arm_l_link7"/>
    <child link="$(arg prefix)end_effector_l_link"/>
    <origin xyz="0 0 -0.215" rpy="0 0 0"/>
  </joint>

  <link name="$(arg prefix)end_effector_l_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01" />
      </geometry>
      <material name="red">
        <color rgba="1.0 0.0 0.0 1"/>
      </material>
    </visual>
  </link>

  <xacro:if value="${use_gripper}">
    <xacro:rh_p12_rn_a parent="$(arg prefix)arm_r_link7" prefix="$(arg prefix)gripper_r_">
      <origin xyz="0 0 -0.078" rpy="0 3.14159265359 3.14159265359"/>
    </xacro:rh_p12_rn_a>
  </xacro:if>
  <xacro:if value="${right_hand}">
    <xacro:sharpa_wave_mount side="right" parent="$(arg prefix)arm_r_link7"
      adapter="$(arg sharpa_adapter)" mount_yaw="${radians(float($(arg right_hand_mount_deg)))}" />
  </xacro:if>

  <joint name="$(arg prefix)end_effector_r_joint" type="fixed">
    <parent link="$(arg prefix)arm_r_link7"/>
    <child link="$(arg prefix)end_effector_r_link"/>
    <origin xyz="0 0 -0.215" rpy="0 0 0"/>
  </joint>

  <link name="$(arg prefix)end_effector_r_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01" />
      </geometry>
      <material name="red">
        <color rgba="1.0 0.0 0.0 1"/>
      </material>
    </visual>
  </link>

  <joint name="$(arg prefix)left_wheel_steer" type="revolute">
      <parent link="$(arg prefix)base_link"/>
      <child link="$(arg prefix)left_wheel_steer_link"/>
      <origin xyz="0.1371 0.2554 0.27555" rpy="0 0 0"/>
      <axis xyz="0 0 1" />
      <limit velocity="9999.0" effort="9999.0" lower="${-pi*6.0}" upper="${pi*6.0}" />
  </joint>
  <link name="$(arg prefix)left_wheel_steer_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/left_wheel_steer_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/left_wheel_steer_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <inertial>
       <origin xyz="9.802769300e-03 -5.471240900e-02 -1.376533800e-01" />
       <mass value="7.550951000e-01" />
       <inertia ixx="2.797326600e-03" ixy="-3.290807800e-05" ixz="-1.950671800e-04"
       iyy="3.582264900e-03" iyz="-2.853290700e-04"
       izz="1.683594000e-03" />
    </inertial>
  </link>
  <joint name="$(arg prefix)left_wheel_drive" type="continuous">
      <parent link="$(arg prefix)left_wheel_steer_link"/>
      <child link="$(arg prefix)left_wheel_drive_link"/>
      <origin xyz="0 0 -0.18905" rpy="0 0 0"/>
      <axis xyz="0 1 0" />
      <limit velocity="9999.0" effort="9999.0"/>
  </joint>
  <link name="$(arg prefix)left_wheel_drive_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/left_wheel_drive_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <!-- <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/left_wheel_drive_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision> -->
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0865" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
       <origin xyz="0.000000000e+00 -1.499601700e-03 0.000000000e+00" />
       <mass value="3.795460500e+00" />
       <inertia ixx="7.187881500e-03" ixy="0.000000000e+00" ixz="0.000000000e+00"
       iyy="1.156399900e-02" iyz="0.000000000e+00"
       izz="7.187977000e-03" />
    </inertial>
  </link>

  <joint name="$(arg prefix)right_wheel_steer" type="revolute">
      <parent link="$(arg prefix)base_link"/>
      <child link="$(arg prefix)right_wheel_steer_link"/>
      <origin xyz="0.1371 -0.2554 0.27555" rpy="0 0 0"/>
      <axis xyz="0 0 1" />
      <limit velocity="9999.0" effort="9999.0" lower="${-pi*6.0}" upper="${pi*6.0}" />
  </joint>
  <link name="$(arg prefix)right_wheel_steer_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/right_wheel_steer_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/right_wheel_steer_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <inertial>
       <origin xyz="9.802728600e-03 5.471240900e-02 -1.376533400e-01" />
       <mass value="7.550951000e-01" />
       <inertia ixx="2.797322900e-03" ixy="3.290833300e-05" ixz="-1.950642500e-04"
       iyy="3.582262300e-03" iyz="2.853288400e-04"
       izz="1.683595100e-03" />
    </inertial>
  </link>
  <joint name="$(arg prefix)right_wheel_drive" type="continuous">
      <parent link="$(arg prefix)right_wheel_steer_link"/>
      <child link="$(arg prefix)right_wheel_drive_link"/>
      <origin xyz="0 0 -0.18905" rpy="0 0 0"/>
      <axis xyz="0 1 0" />
      <limit velocity="9999.0" effort="9999.0"/>
  </joint>
  <link name="$(arg prefix)right_wheel_drive_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/right_wheel_drive_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <!-- <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/right_wheel_drive_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision> -->
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0865" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
       <origin xyz="0.000000000e+00 1.499601700e-03 0.000000000e+00" />
       <mass value="3.795460500e+00" />
       <inertia ixx="7.187881500e-03" ixy="0.000000000e+00" ixz="0.000000000e+00"
       iyy="1.156399900e-02" iyz="0.000000000e+00"
       izz="7.187977000e-03" />
    </inertial>
  </link>

  <joint name="$(arg prefix)rear_wheel_steer" type="revolute">
      <parent link="$(arg prefix)base_link"/>
      <child link="$(arg prefix)rear_wheel_steer_link"/>
      <origin xyz="-0.2899 0 0.27555" rpy="0 0 0"/>
      <axis xyz="0 0 1" />
      <limit velocity="9999.0" effort="9999.0" lower="${-pi*6.0}" upper="${pi*6.0}" />
  </joint>
  <link name="$(arg prefix)rear_wheel_steer_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/rear_wheel_steer_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/rear_wheel_steer_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <inertial>
       <origin xyz="9.802728600e-03 5.471240900e-02 -1.376533400e-01" />
       <mass value="7.550951000e-01" />
       <inertia ixx="2.797322900e-03" ixy="3.290833300e-05" ixz="-1.950642500e-04"
       iyy="3.582262300e-03" iyz="2.853288400e-04"
       izz="1.683595100e-03" />
    </inertial>
  </link>
  <joint name="$(arg prefix)rear_wheel_drive" type="continuous">
      <parent link="$(arg prefix)rear_wheel_steer_link"/>
      <child link="$(arg prefix)rear_wheel_drive_link"/>
      <origin xyz="0 0 -0.18905" rpy="0 0 0"/>
      <axis xyz="0 1 0" />
      <limit velocity="9999.0" effort="9999.0"/>
  </joint>
  <link name="$(arg prefix)rear_wheel_drive_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/rear_wheel_drive_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0865" length="0.05"/>
      </geometry>
    </collision>
    <!-- <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/rear_wheel_drive_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision> -->
    <inertial>
       <origin xyz="0.000000000e+00 1.499601700e-03 0.000000000e+00" />
       <mass value="3.795460500e+00" />
       <inertia ixx="7.187881500e-03" ixy="0.000000000e+00" ixz="0.000000000e+00"
       iyy="1.156399900e-02" iyz="0.000000000e+00"
       izz="7.187977000e-03" />
    </inertial>
  </link>

  <xacro:ffw_sg2_follower_system
    use_sim="$(arg use_sim)"
    use_mock_hardware="$(arg use_mock_hardware)"
    mock_sensor_commands="$(arg mock_sensor_commands)"
    use_gripper="${use_gripper}"/>

  <xacro:if value="${left_hand}">
    <xacro:sharpa_wave_hand_system side="left"
      ip="$(arg left_hand_ip)" serial_number="$(arg left_hand_serial)"
      speed_coeff="$(arg hand_speed_coeff)"
      use_sim="$(arg use_sim)" use_mock_hardware="$(arg use_mock_hardware)"
      mock_sensor_commands="$(arg mock_sensor_commands)"/>
  </xacro:if>
  <xacro:if value="${right_hand}">
    <xacro:sharpa_wave_hand_system side="right"
      ip="$(arg right_hand_ip)" serial_number="$(arg right_hand_serial)"
      speed_coeff="$(arg hand_speed_coeff)"
      use_sim="$(arg use_sim)" use_mock_hardware="$(arg use_mock_hardware)"
      mock_sensor_commands="$(arg mock_sensor_commands)"/>
  </xacro:if>

  <xacro:ffw_sg2_base_system
    use_sim="$(arg use_sim)"
    use_mock_hardware="$(arg use_mock_hardware)"
    mock_sensor_commands="$(arg mock_sensor_commands)"/>

  <xacro:ffw_sg2_sensor_system
    use_sim="$(arg use_sim)"
    use_mock_hardware="$(arg use_mock_hardware)"
    mock_sensor_commands="$(arg mock_sensor_commands)"/>

  <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find ffw_bringup)/config/$(arg model)/ffw_sg2_follower_ai_hardware_controller.yaml</parameters>
      </plugin>
  </gazebo>

</robot>

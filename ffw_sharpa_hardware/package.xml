  <version>2.3.2</version>
  <description>ros2_control hardware interface for Sharpa Wave hands on the AI Worker, using the vendor's SharpaWave SDK.</description>
  <maintainer email="ojh6404@gmail.com">Jihoon Oh</maintainer>
  <license>Apache-2.0</license>
  <author email="ojh6404@gmail.com">Jihoon Oh</author>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>diagnostic_msgs</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
